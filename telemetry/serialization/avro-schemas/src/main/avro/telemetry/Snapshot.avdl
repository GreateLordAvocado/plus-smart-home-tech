@namespace("ru.yandex.practicum.kafka.telemetry.event")
protocol SnapshotProtocol {

  import idl "SensorEvent.avdl";

  record SnapshotAvro {
    string hubId;
    long timestamp;

    map<union {
      ClimateSensorAvro,
      LightSensorAvro,
      MotionSensorAvro,
      SwitchSensorAvro,
      TemperatureSensorAvro
    }> sensors;
  }
}
